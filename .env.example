# App URL — use 127.0.0.1 (not localhost) to avoid Canva CORS issues during local dev
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Dashboard / auth API (Node Express)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Public vcard templates (Laravel — template-services parity)
NEXT_PUBLIC_LARAVEL_API_URL=https://app.vbizme.com/api

# Live Agent (Gemini)
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=

# Push notifications (VAPID) — public key from Laravel; private key stays on server only
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:support@vbizme.com
# Leave empty to use NEXT_PUBLIC_LARAVEL_API_URL for /push/*
NEXT_PUBLIC_PUSH_API_URL=

# Canva Connect API credentials (from https://www.canva.com/developers/integrations/connect-api)
CANVA_CLIENT_ID=your_canva_client_id
CANVA_CLIENT_SECRET=cnvca_your_canva_client_secret

# Must match a redirect URL configured in your Canva integration settings
CANVA_REDIRECT_URI=http://127.0.0.1:3000/api/canva/callback

# Space-separated scopes — must match scopes enabled in the Canva Developer Portal
CANVA_SCOPES=asset:read asset:write design:meta:read design:content:read folder:read profile:read

# Optional overrides (defaults shown)
# CANVA_AUTH_BASE_URL=https://www.canva.com/api/oauth/authorize
# CANVA_API_BASE_URL=https://api.canva.com/rest/v1

# Encrypts stored OAuth tokens on disk (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CANVA_TOKEN_ENCRYPTION_KEY=replace_with_64_char_hex_string

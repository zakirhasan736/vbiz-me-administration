NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Server-only (never NEXT_PUBLIC). Next SSR/route handlers should call the local API.
SERVER_API_URL=http://127.0.0.1:5000/api/v1
# Same value as backend INTERNAL_PUBLIC_API_KEY. Never NEXT_PUBLIC.
INTERNAL_PUBLIC_API_KEY=
# Public admin URL (used for post-OAuth return links from the backend FRONTEND_URL)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Must match the public half of backend VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY.
# Frontend also fetches GET /api/v1/public/push/vapid-public-key at subscribe time.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Optional override; defaults to `${NEXT_PUBLIC_API_URL}/public`
NEXT_PUBLIC_PUSH_API_URL=

# Public Cloudflare Turnstile site key for login, registration, and forgot-password.
# The matching secret key belongs in the backend TURNSTILE_SECRET_KEY only.
# Optional. Default false: /register redirects to login.
# Set true only when public self-serve signup should be shown again.
NEXT_PUBLIC_PUBLIC_SIGNUP_ENABLED=false

# Canva secrets live on the BACKEND only (CANVA_CLIENT_ID / CANVA_CLIENT_SECRET / CANVA_TOKEN_ENCRYPTION_KEY).
# Do not put Canva secrets here — the admin app talks to /api/v1/integrations/canva.

# Gemini Live assistant: GEMINI_API_KEY belongs in the backend .env only. Never NEXT_PUBLIC_*.
